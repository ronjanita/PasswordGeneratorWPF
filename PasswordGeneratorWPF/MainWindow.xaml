<Window x:Class="PasswordGeneratorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordGeneratorWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="550">
    <Grid Margin="11">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="176" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="welcomeblock" Text="Welcome to this password generator, follow the instructions and be safe!" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Height="30" HorizontalAlignment="Center"  VerticalAlignment="Center" FontSize="15" FontStyle="Oblique" FontWeight="Bold"  Background="LightBlue" Padding="5" TextAlignment="Center"/>
        <TextBlock x:Name="passwordlengthblock" Text="Use the slider to define the exact number of characters used for the final password:" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="13" FontWeight="Light" Height="35" VerticalAlignment="Top" Background="AntiqueWhite"/>
        <Slider x:Name="slider" Grid.Row="1" Grid.Column="2" Margin="10" Height="20" VerticalAlignment="Top"/>
        <TextBlock x:Name="userpreference" Text="Enter a word, symbol or digit you want to get included in the generated password:" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="13" FontWeight="Light" Height="35" VerticalAlignment="Bottom" Background="AntiqueWhite"/>

    </Grid>
</Window>
