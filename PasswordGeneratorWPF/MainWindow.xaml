<Window x:Class="PasswordGeneratorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordGeneratorWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="550">
    <Grid Margin="11">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="176" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Welcomeblock" Text="Welcome to this password generator, follow the instructions and be safe!" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Height="35" HorizontalAlignment="Center"  VerticalAlignment="Center" FontSize="15" FontStyle="Oblique" FontWeight="Bold"  Background="LightBlue" Padding="5" TextAlignment="Center"/>
        <TextBlock x:Name="Passwordlengthblock" Text="Use the slider to define the exact number of characters used for the final password:" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="13" FontWeight="Light" Height="35" VerticalAlignment="Top"/>
        <Slider x:Name="Slider" Grid.Row="1" Grid.Column="2" Margin="10" Height="20" VerticalAlignment="Top" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
        <TextBlock x:Name="Userpreference" Text="Enter a word, symbol or digit you want to get included in the generated password:" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="13" FontWeight="Light" Height="35" VerticalAlignment="Bottom"/>
        <TextBox x:Name="Userinputtext" Grid.Row="1" Grid.Column="2" Background="LightGray" Height="35" VerticalAlignment="Bottom" Margin="10,0" TextChanged="Userinputtext_TextChanged"/>
        <CheckBox x:Name="Uppercase" Content="use uppercase" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="Light" FontSize="13"/>
        <CheckBox x:Name="Digits" Content="use digits" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Light" FontSize="13"/>
        <CheckBox x:Name="Symbols" Content="use symbols" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="80,0,0,0" FontWeight="Light" FontSize="13" />
        <Button x:Name="Generatepassword" Content="generate password" Grid.Row="3" Height="35" FontSize="15" FontStyle="Oblique" FontWeight="Bold"  Background="LightBlue" Padding="5" HorizontalAlignment="Center"  VerticalAlignment="Center" Width="176" Click="Generatepassword_Click"/>
        <TextBlock x:Name="Finalpassword"  Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" TextWrapping="Wrap" Height="35" VerticalAlignment="Center" Margin="10,0,2,0" Background="LightGray"/>
    </Grid>
</Window>
